// The public surface of this crate. Everything importable from "@FxvDiff" is listed here and
// nowhere else; everything under internal/ is private.

import { CodeView } from "internal/code-view.slint";
import { DiffView } from "internal/diff-view.slint";
import { CodeStyle } from "internal/style.slint";
import { CodeScrollbar } from "internal/scrollbar.slint";
import {
    CodeRow,
    CodeGapState,
    DiffRowClasses,
    CodeHighlight,
    CodePosition,
    CodeSelection,
    CodeLine,
    DiffGapExpandRequest,
} from "internal/types.slint";

// Both panes are importable on their own: `CodeView` shows monospace text with line numbers,
// highlights and selection, and `DiffView` is the same pane with gaps and their controls added.
// Neither is built from the other, because a component that owns a ListView also fixes which
// row component the list builds; what they share is their row and their arithmetic.
//
// CodeView and CodeScrollbar are instantiated from .slint only, which is just as well: the
// generated Rust module contains only the last exported component, so DiffView comes after
// both. A consumer instantiating CodeView in its own markup is unaffected by that.
export { CodeScrollbar }
export { CodeView }
export { DiffView, CodeStyle }
export { CodeRow, CodeGapState, DiffRowClasses }
export { CodeHighlight }
// Vocabulary both panes speak, rather than anything about diffs.
export { CodeLine, CodePosition, CodeSelection }
export { DiffGapExpandRequest }
