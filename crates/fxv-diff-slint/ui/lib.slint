// The public surface of this crate. Everything importable from "@FxvDiff" is listed here and
// nowhere else; everything under internal/ is private.

import { DiffView } from "internal/diff-view.slint";
import { DiffStyle } from "internal/style.slint";
import { DiffScrollbar } from "internal/scrollbar.slint";
import {
    DiffRow,
    DiffRowKind,
    DiffGapState,
    DiffHighlight,
    DiffHighlightKind,
    DiffSide,
    DiffLineRef,
    DiffLayoutMode,
    GapExpandRequest,
} from "internal/types.slint";

// DiffScrollbar is only ever instantiated from .slint, which is just as well: the generated
// Rust module contains only the last exported component, so DiffView has to come after it.
export { DiffScrollbar }
export { DiffView, DiffStyle }
export { DiffRow, DiffRowKind, DiffGapState, DiffSide, DiffLineRef, DiffLayoutMode }
export { DiffHighlight, DiffHighlightKind }
export { GapExpandRequest }
