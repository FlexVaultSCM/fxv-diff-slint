import { DiffStyle } from "style.slint";
import { DiffRow, PanePosition } from "types.slint";

// One rendered row of any pane: a gutter carrying line numbers, then the line body.
//
// Knows nothing about diffs. It draws text, whatever is highlighted over it, and whatever is
// selected, and reports where a pointer went. A diff adds to this rather than replacing it.
//
// The three children each do one job, and they cannot be folded together:
//
//   - the spacer declares how far the list can scroll sideways,
//   - the body paints the row and holds its text,
//   - the gutter holds the left edge while the body slides behind it.
export component RowView {
    in property <DiffRow> data;
    in property <length> advance;
    in property <length> letter-spacing;
    in property <length> gutter-width;
    in property <length> content-width;
    /// The list's horizontal scroll position. Zero at the left, negative as it moves right.
    in property <length> scroll-x;
    /// How much of the list is on screen at once.
    in property <length> visible-width;
    in property <bool> show-line-numbers: true;
    /// How many number columns the gutter draws, filled from the row's first number onward.
    ///
    /// A pane showing one file draws one; an inline view of a diff draws two, since an
    /// unchanged line has a number in each file.
    in property <int> gutter-columns: 2;

    /// This row's own index, for reporting where a gesture is and what to draw.
    in property <int> index;

    /// The selection on screen, already ordered so that start comes before end. A start row of
    /// -1 means there is none. Ordered by the view so every row is spared working out which end
    /// is which.
    in property <PanePosition> sel-start: { row: -1, column: 0 };
    in property <PanePosition> sel-end: { row: -1, column: 0 };
    /// Whether dragging selects at all.
    in property <bool> selectable: false;

    // Whether this row may be part of a selection. A row outside every run has an empty one,
    // which is how a gap or a header says it breaks a selection rather than joining it.
    out property <bool> in-a-run: root.data.run-end > root.data.run-start;

    /// Pointer went down on this row, at a position.
    callback select-start(PanePosition);
    /// Pointer moved to a position, already clamped to this row's run.
    callback select-to(PanePosition);
    /// Pointer released.
    callback select-end();

    callback clicked();

    // Rows that stand for content have line numbers; the rest do not. A filler has none
    // either, but it is still a line's worth of one side of the diff.

    out property <length> full-width: root.gutter-width + root.content-width;

    // Declares how far the list can scroll sideways, and does nothing else.
    //
    // A ListView takes its scrollable width from the largest minimum width among its rows, so
    // this has to be a minimum rather than a width, and it has to be on a child rather than on
    // the component root, whose constraints never reach the layout information the list reads.
    // It also cannot be the body below: an element given an explicit `x` drops out of its
    // parent's layout information, and the body needs one.
    Rectangle {
        min-width: root.full-width;
    }

    i-body := Rectangle {
        // Anchored, because a child wider than its parent is centred by default, which shifts
        // the whole line left by half the overflow and pushes short ones off the edge.
        x: 0;
        // Sized to the whole scrollable width rather than the row's own, which the list sets
        // to the visible width. A background only as wide as the viewport runs out the moment
        // the view scrolls sideways, leaving changed lines half-tinted. The visible width is
        // the floor so a file of only short lines still paints across the pane.
        width: max(root.visible-width, root.full-width);

        // A class with no entry draws nothing of its own, which is the same choice the
        // highlight channels make: an unstyled class in some arbitrary colour would read as
        // meaning something.
        background: DiffStyle.class-backgrounds[root.data.class];

        i-touch := TouchArea {
            // An i-beam only where a drag would actually select something, so the pointer does
            // not promise selection over a gap, a header, or a pane whose host wants none.
            mouse-cursor: root.selectable && root.in-a-run
                ? MouseCursor.text
                : MouseCursor.default;

            // The column a position falls on, rounded to the nearest boundary between
            // characters rather than truncated, so the near edge of a glyph selects before it
            // and the far edge after it. Body coordinates already start at the content origin,
            // so the horizontal scroll needs no undoing here.
            function column-at(x: length) -> int {
                max(0, round((x - (root.show-line-numbers ? root.gutter-width : 0px))
                    / root.advance));
            }

            // A drag that leaves this row keeps reporting to it, because a TouchArea holds the
            // pointer until release. So the row under the pointer is this row plus however many
            // row heights away it now is, clamped to the run this row belongs to.
            function row-at(y: length) -> int {
                clamp(root.index + floor(y / root.height),
                    root.data.run-start, max(root.data.run-start, root.data.run-end - 1));
            }

            pointer-event(event) => {
                if (!root.selectable || !root.in-a-run) {
                    return;
                }
                if (event.kind == PointerEventKind.down) {
                    root.select-start({ row: root.index, column: self.column-at(self.mouse-x) });
                } else if (event.kind == PointerEventKind.up) {
                    root.select-end();
                }
            }

            moved => {
                if (root.selectable && root.in-a-run && self.pressed) {
                    root.select-to({
                        row: self.row-at(self.mouse-y),
                        column: self.column-at(self.mouse-x),
                    });
                }
            }

            clicked => {
                root.clicked();
            }
        }

        // This row's share of the selection, drawn from properties rather than from the model
        // so that dragging the pointer writes nothing and costs no rebuild.
        //
        // A row in the middle of a selection runs to its own edge, which takes in the line
        // ending: past the last character the newline is what the rest of the row stands for.
        if root.sel-start.row >= 0 && root.index >= root.sel-start.row
            && root.index <= root.sel-end.row: i-selection := Rectangle {
            property <int> from: root.index == root.sel-start.row ? root.sel-start.column : 0;
            // Every row but the last takes its line ending with it, which is drawn as one
            // column past the text. Without it a blank line inside a selection would paint
            // nothing at all and read as a hole.
            property <bool> takes-ending: root.index != root.sel-end.row;
            property <int> to: self.takes-ending ? root.data.columns : root.sel-end.column;

            x: (root.show-line-numbers ? root.gutter-width : 0px) + self.from * root.advance;
            y: 0;
            width: max(0px, (self.to - self.from) * root.advance)
                + (self.takes-ending ? root.advance : 0px);
            height: parent.height;
            background: DiffStyle.selection-background;
        }

        // Ranges painted behind the text: what is selected, and whatever the host is
        // pointing at. Column to x is a multiplication because the grid is monospace and
        // nothing wraps, so this needs no text layout query. The same arithmetic serves any
        // range, whatever put it there.
        for highlight in root.data.highlights: i-highlight := Rectangle {
            x: (root.show-line-numbers ? root.gutter-width : 0px) + highlight.start * root.advance;
            y: 0;
            // A span covering the line ending runs to the body's own edge, which is the whole
            // scrollable width rather than the visible one, so it keeps reaching the edge when
            // the view is scrolled sideways.
            width: highlight.to-end
                ? parent.width - self.x
                : (highlight.end - highlight.start) * root.advance;
            height: parent.height;
            background: DiffStyle.channel-backgrounds[highlight.channel];
        }

        i-content := Text {
            // Content sits to the right of the gutter and scrolls with the list. A header
            // describes the file rather than sitting in it, so it is pinned against the
            // visible left edge instead.
            x: root.data.full-width
                ? -root.scroll-x + DiffStyle.gutter-padding
                : (root.show-line-numbers ? root.gutter-width : 0px);
            y: 0;
            height: parent.height;
            text: root.data.text;
            font-family: DiffStyle.font-family;
            font-size: DiffStyle.font-size;
            letter-spacing: root.letter-spacing;
            color: DiffStyle.text-color;
            vertical-alignment: center;
        }
    }

    // Drawn last so the body passes behind it rather than showing through.
    if root.show-line-numbers && !root.data.full-width: i-gutter := Rectangle {
        x: -root.scroll-x;
        width: root.gutter-width;
        background: DiffStyle.gutter-background;

        HorizontalLayout {
            padding-left: DiffStyle.gutter-padding;
            padding-right: DiffStyle.gutter-padding;
            spacing: DiffStyle.gutter-padding;

            if root.gutter-columns >= 1: i-number := Text {
                width: 4 * root.advance;
                // Read back by the widget tests, since what a gutter drew is otherwise
                // invisible from outside.
                accessible-role: text;
                accessible-label: self.text;
                // Zero means this row has no number in that column, which a filler has and a
                // row that names no line at all has.
                text: root.data.numbered && root.data.left-line > 0 ? root.data.left-line : "";
                horizontal-alignment: right;
                vertical-alignment: center;
                font-family: DiffStyle.font-family;
                font-size: DiffStyle.font-size;
                color: DiffStyle.gutter-text-color;
            }

            if root.gutter-columns >= 2: i-number-2 := Text {
                width: 4 * root.advance;
                accessible-role: text;
                accessible-label: self.text;
                text: root.data.numbered && root.data.right-line > 0 ? root.data.right-line : "";
                horizontal-alignment: right;
                vertical-alignment: center;
                font-family: DiffStyle.font-family;
                font-size: DiffStyle.font-size;
                color: DiffStyle.gutter-text-color;
            }
        }
    }

    // Where a row that adds to this one puts its own parts. Last, so they draw over the body;
    // the gutter is skipped on the rows that use this, so the two never contend.
    @children
}
