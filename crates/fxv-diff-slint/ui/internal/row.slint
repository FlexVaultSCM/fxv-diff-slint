import { Spinner } from "std-widgets.slint";
import { DiffStyle } from "style.slint";
import { DiffRow, DiffRowKind, DiffGapState, DiffSide } from "types.slint";
import { GapButton } from "gap-button.slint";

// One rendered row: a gutter carrying line numbers, then the line body.
//
// The three children each do one job, and they cannot be folded together:
//
//   - the spacer declares how far the list can scroll sideways,
//   - the body paints the row and holds its text,
//   - the gutter holds the left edge while the body slides behind it.
export component DiffRowView {
    in property <DiffRow> data;
    in property <length> advance;
    in property <length> letter-spacing;
    in property <length> gutter-width;
    in property <length> content-width;
    /// The list's horizontal scroll position. Zero at the left, negative as it moves right.
    in property <length> scroll-x;
    /// How much of the list is on screen at once.
    in property <length> visible-width;
    in property <bool> show-line-numbers: true;
    // Which side's numbers to show. A pane of a side-by-side view shows only its own.
    in property <DiffSide> number-side: DiffSide.both;

    callback clicked();
    /// Asks for `count` lines starting at the given line on each side.
    callback expand(int, int, int);
    /// How many lines one step of a gap opens.
    in property <int> expand-step: 20;
    /// Whether a gap offers to open at all. Off for a diff nobody can fetch lines for.
    in property <bool> gap-expandable: false;

    // Rows that stand for content have line numbers; the rest do not. A filler has none
    // either, but it is still a line's worth of one side of the diff.
    out property <bool> numbered: root.data.kind != DiffRowKind.gap
        && root.data.kind != DiffRowKind.filler
        && root.data.kind != DiffRowKind.header;

    // Rows that are about the file rather than a line in it drop the gutter and run the full
    // width. A filler must not: it stands opposite a real line in the other pane, and losing
    // its gutter would put the two panes out of step.
    out property <bool> spans-gutter: root.data.kind == DiffRowKind.gap
        || root.data.kind == DiffRowKind.header;

    out property <length> full-width: root.gutter-width + root.content-width;

    // How much one step opens, never more than the gap holds.
    out property <int> step: min(root.expand-step, root.data.hidden-count);
    // Opening from one end only makes sense when a step leaves something behind.
    out property <bool> stepped: root.data.hidden-count > root.expand-step;

    out property <bool> gap-waiting: root.data.kind == DiffRowKind.gap
        && root.data.gap-state == DiffGapState.waiting;
    out property <bool> gap-failed: root.data.kind == DiffRowKind.gap
        && root.data.gap-state == DiffGapState.failed;

    // The two affordances, as opposed to the two states above. Both need somewhere for the
    // lines to come from, so both are gated on the view being expandable at all; the states
    // are not, because a gap that says it is loading is reporting rather than offering.
    out property <bool> gap-openable: root.data.kind == DiffRowKind.gap
        && root.data.gap-state == DiffGapState.hidden
        && root.gap-expandable;
    out property <bool> gap-retryable: root.gap-failed && root.gap-expandable;

    // Reserved for whichever set of gap controls is showing, so the label beside them starts
    // in the same place whatever the gap is doing. Zero when there are none, which is a gap in
    // a diff nobody can fetch for: it still says how many lines it stands for, at the margin.
    out property <length> gap-controls-width:
        root.gap-waiting ? 2 * root.advance + 2 * DiffStyle.gutter-padding
            : root.gap-retryable ? 7 * root.advance + 2 * DiffStyle.gutter-padding
            : root.gap-openable
                ? (root.stepped ? 26 : 10) * root.advance + 4 * DiffStyle.gutter-padding
            : 0px;

    // Declares how far the list can scroll sideways, and does nothing else.
    //
    // A ListView takes its scrollable width from the largest minimum width among its rows, so
    // this has to be a minimum rather than a width, and it has to be on a child rather than on
    // the component root, whose constraints never reach the layout information the list reads.
    // It also cannot be the body below: an element given an explicit `x` drops out of its
    // parent's layout information, and the body needs one.
    Rectangle {
        min-width: root.full-width;
    }

    Rectangle {
        // Anchored, because a child wider than its parent is centred by default, which shifts
        // the whole line left by half the overflow and pushes short ones off the edge.
        x: 0;
        // Sized to the whole scrollable width rather than the row's own, which the list sets
        // to the visible width. A background only as wide as the viewport runs out the moment
        // the view scrolls sideways, leaving changed lines half-tinted. The visible width is
        // the floor so a file of only short lines still paints across the pane.
        width: max(root.visible-width, root.full-width);

        background: root.data.kind == DiffRowKind.added ? DiffStyle.added-background
            : root.data.kind == DiffRowKind.removed ? DiffStyle.removed-background
            : root.data.kind == DiffRowKind.gap ? DiffStyle.gap-background
            : root.data.kind == DiffRowKind.filler ? DiffStyle.filler-background
            : DiffStyle.context-background;

        i-touch := TouchArea {
            clicked => {
                root.clicked();
            }
        }

        Text {
            // Content sits to the right of the gutter and scrolls with the list. Gaps and
            // headers describe the file rather than sitting in it, so they are pinned against
            // the visible left edge instead.
            x: root.data.kind == DiffRowKind.gap
                ? -root.scroll-x + root.gap-controls-width + DiffStyle.gutter-padding
                : root.spans-gutter
                    ? -root.scroll-x + DiffStyle.gutter-padding
                    : (root.show-line-numbers ? root.gutter-width : 0px);
            y: 0;
            height: parent.height;
            // A gap says how many lines it stands for and what is happening to them. Its
            // `text` is the hunk heading, or the reason a fetch failed, so it reads as
            // "12 hidden    fn thing()" or "12 could not be read    no such revision".
            text: root.data.kind == DiffRowKind.gap
                ? "  " + root.data.hidden-count
                    + (root.gap-waiting ? " loading"
                        : root.gap-failed ? " could not be read"
                        : " hidden")
                    + (root.data.text == "" ? "" : "    " + root.data.text)
                : root.data.text;
            font-family: DiffStyle.font-family;
            font-size: DiffStyle.font-size;
            letter-spacing: root.letter-spacing;
            color: DiffStyle.text-color;
            vertical-alignment: center;
        }
    }

    // Controls for opening a gap, pinned against the visible edge like the gap's own label.
    //
    // A gap can be opened a piece at a time from either end, which is what makes a large one
    // usable: a few lines of extra context is the common need, not the whole span. When the
    // gap is no larger than a step there is only one thing to do, so only one control shows.
    if root.gap-openable: HorizontalLayout {
        x: -root.scroll-x + DiffStyle.gutter-padding;
        y: 0;
        width: root.gap-controls-width;
        height: parent.height;
        spacing: DiffStyle.gutter-padding;

        if root.stepped: GapButton {
            label: "v " + root.step;
            // Opens the top of the gap, next to the hunk above it.
            clicked => {
                root.expand(root.data.left-line, root.data.right-line, root.step);
            }
        }

        if root.stepped: GapButton {
            label: "^ " + root.step;
            // Opens the bottom, next to the hunk below.
            clicked => {
                root.expand(
                    root.data.left-line + root.data.hidden-count - root.step,
                    root.data.right-line + root.data.hidden-count - root.step,
                    root.step);
            }
        }

        GapButton {
            label: "all " + root.data.hidden-count;
            clicked => {
                root.expand(
                    root.data.left-line, root.data.right-line, root.data.hidden-count);
            }
        }
    }

    // A gap being fetched offers nothing to click: the run it covers is spoken for until the
    // lines arrive or the attempt fails.
    if root.gap-waiting: HorizontalLayout {
        x: -root.scroll-x + DiffStyle.gutter-padding;
        y: 0;
        width: root.gap-controls-width;
        height: parent.height;
        alignment: center;

        Spinner {
            // Square, and short of the full row so it does not touch the rows above and below.
            height: parent.height - 4px;
            width: self.height;
            indeterminate: true;
        }
    }

    // A run that failed is still exactly the run that was asked for, so retrying is one click
    // on the same request rather than a fresh choice of how much to open.
    if root.gap-retryable: HorizontalLayout {
        x: -root.scroll-x + DiffStyle.gutter-padding;
        y: 0;
        width: root.gap-controls-width;
        height: parent.height;

        GapButton {
            label: "retry";
            clicked => {
                root.expand(
                    root.data.left-line, root.data.right-line, root.data.hidden-count);
            }
        }
    }

    // Drawn last so the body passes behind it rather than showing through.
    if root.show-line-numbers && !root.spans-gutter: Rectangle {
        x: -root.scroll-x;
        width: root.gutter-width;
        background: DiffStyle.gutter-background;

        HorizontalLayout {
            padding-left: DiffStyle.gutter-padding;
            padding-right: DiffStyle.gutter-padding;
            spacing: DiffStyle.gutter-padding;

            if root.number-side != DiffSide.right: Text {
                width: 4 * root.advance;
                // Zero means this row has no line on that side. Gaps and fillers do carry
                // numbers, since expanding a gap has to know where to read from, but showing
                // one against a blank row would misdescribe it.
                text: root.numbered && root.data.left-line > 0 ? root.data.left-line : "";
                horizontal-alignment: right;
                vertical-alignment: center;
                font-family: DiffStyle.font-family;
                font-size: DiffStyle.font-size;
                color: DiffStyle.gutter-text-color;
            }

            if root.number-side != DiffSide.left: Text {
                width: 4 * root.advance;
                text: root.numbered && root.data.right-line > 0 ? root.data.right-line : "";
                horizontal-alignment: right;
                vertical-alignment: center;
                font-family: DiffStyle.font-family;
                font-size: DiffStyle.font-size;
                color: DiffStyle.gutter-text-color;
            }
        }
    }
}
