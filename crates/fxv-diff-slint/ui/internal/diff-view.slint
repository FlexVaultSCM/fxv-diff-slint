import { CodeView } from "code-view.slint";

// A pane showing a diff.
//
// The same component as `CodeView`, under the name a consumer showing a change will look for.
// Nothing is added, and that is the finding rather than an oversight: everything that once made
// this different has turned out to be general. Hidden content is not a diff idea, a partial
// preview has it too; fetching it is the same request whatever is behind it; and which document
// a line belongs to is a number rather than a side. What is left that is genuinely about diffs
// is all in Rust, in the code that turns a parsed diff into rows.
export component DiffView inherits CodeView { }
