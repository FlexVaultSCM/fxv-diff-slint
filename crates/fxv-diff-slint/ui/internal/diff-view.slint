import { ListView } from "std-widgets.slint";
import { CodeStyle } from "style.slint";
import { GridMetrics } from "metrics.slint";
import { CodeMath } from "code-math.slint";
import { DiffRowView } from "diff-row.slint";
import {
    CodeRow, CodeLine, CodePosition, CodeSelection, DiffGapExpandRequest,
} from "types.slint";

// A pane of monospace text showing a diff.
//
// The same pane as `CodeView` with gaps added: rows that stand for content not on screen, and
// the controls that ask for it. The two cannot be built from one another, because a component
// that owns a ListView also fixes which row component the list builds and Slint has no way to
// vary that. What they share instead is `CodeMath` and the row each one draws.
export component DiffView {
    in property <[CodeRow]> rows;
    in property <bool> show-line-numbers: true;
    /// How many number columns the gutter carries, filled from each row's first number.
    ///
    /// A pane showing one file sets one. An inline view of a diff leaves it at two, because an
    /// unchanged line has a number in each file and both are worth reading.
    in property <int> gutter-columns: 2;
    // Turned off when something outside drives the horizontal scrolling, so two panes shown
    // together can share one bar instead of having two that always agree.
    in property <bool> show-horizontal-scrollbar: true;

    // How many columns the longest line in `rows` occupies. This is a property of the content,
    // not of the viewport.
    //
    // It has to be supplied because it cannot be derived here. Slint has no aggregate over a
    // model, and iterating would not help: ListView only instantiates visible rows, so a
    // maximum taken over them would change as the view scrolls. Whatever builds the row list
    // computes this in the same pass.
    //
    // Two panes shown side by side must be given the same value, or their scrollable widths
    // differ and the sides drift apart horizontally.
    in property <int> longest-line-columns: 120;

    /// A row to bring into sight, or -1 for none. The row is centred.
    ///
    /// Scrolling happens when this changes, so a view keeps its own position otherwise and this
    /// never fights manual scrolling. Set `reveal-token` as well to ask for the same row twice.
    in property <int> reveal-row: -1;
    /// Bumped to ask for `reveal-row` again when it has not changed.
    in property <int> reveal-token;

    /// Whether dragging in this pane selects.
    ///
    /// Off by default. A pane whose host does nothing with a selection should not offer one.
    in property <bool> selectable: false;

    /// The two ends of the selection.
    ///
    /// A row of -1 on the anchor means there is none. Plain properties on purpose: a drag moves
    /// them and the rows redraw, with nothing written to the model and no span resolved until
    /// the gesture ends.
    in-out property <CodePosition> selection-anchor: { row: -1, column: 0 };
    in-out property <CodePosition> selection-focus: { row: -1, column: 0 };

    /// Raised when a drag finishes, which is when the selection is worth resolving to spans.
    callback selection-finished(CodeSelection);
    callback line-clicked(CodeLine);

    i-metrics := GridMetrics { }

    i-math := CodeMath {
        rows: root.rows;
        row-height: i-metrics.row-height;
        visible-height: i-list.visible-height;
        max-scroll-y: root.max-scroll-y;
        scroll-y: root.scroll-y;
        anchor: root.selection-anchor;
        to: root.selection-focus;
    }

    out property <length> advance: i-metrics.advance;
    out property <length> row-height: i-metrics.row-height;
    out property <length> content-width: root.longest-line-columns * i-metrics.advance;

    // Four digits per column, with padding outside and between.
    out property <int> columns-shown: max(1, root.gutter-columns);
    out property <length> gutter-width: root.show-line-numbers
        ? root.columns-shown * 4 * i-metrics.advance
            + (root.columns-shown + 1) * CodeStyle.gutter-padding
        : 0px;

    out property <length> scrollable-width: root.gutter-width + root.content-width;

    // Scroll position, exposed so two panes showing the same content can be tied together.
    // Both are zero at the start and negative as they move.
    in-out property <length> scroll-x <=> i-list.viewport-x;
    in-out property <length> scroll-y <=> i-list.viewport-y;

    out property <length> visible-width <=> i-list.visible-width;

    // How far down the view can be scrolled. Content shorter than the viewport cannot be
    // scrolled at all, so the range is zero.
    out property <length> max-scroll-y:
        max(0px, root.rows.length * root.row-height - i-list.visible-height);

    // A list normally pulls its own scroll position back into range, but it stops doing that
    // once something outside binds the position, which is exactly what showing two panes in
    // step requires. So the position has to be corrected here instead.
    //
    // Hung off `rows` rather than off the range itself. A property nothing else reads is never
    // evaluated, so a change callback on one never runs; the list reads `rows`.
    changed rows => {
        root.scroll-y = clamp(root.scroll-y, -root.max-scroll-y, 0px);
        // A selection names rows by index, so it means nothing once the rows are different
        // ones. Dropped here rather than left to a host, because the view is what knows the
        // rows changed and a stale selection would draw over whatever now occupies those
        // indices.
        root.selection-anchor.row = -1;
        root.selection-focus.row = -1;
    }

    changed reveal-row => {
        root.scroll-y = i-math.scroll-revealing(root.reveal-row);
    }

    changed reveal-token => {
        root.scroll-y = i-math.scroll-revealing(root.reveal-row);
    }

    // Derived from the character cell and the content, never from root.width: reading the
    // view's own width here would make the layout depend on a value the layout produces.
    preferred-width: root.scrollable-width;
    preferred-height: 25 * root.row-height;
    min-height: 3 * root.row-height;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    /// How many lines one step of a gap opens.
    in property <int> gap-expand-step: 20;
    /// Whether gaps offer to open.
    ///
    /// Off by default, because opening one is a request the host has to answer and there is no
    /// way for this view to know whether it can. A diff with nothing behind it still shows its
    /// gaps, so the file does not read as continuous, but without controls that lead nowhere.
    in property <bool> gap-expandable: false;
    /// Whether this view spells a gap out, or just leaves a band where one is. One pane of a
    /// split carries the detail; the other would only repeat it in half the width.
    in property <bool> gap-details: true;
    /// Whether a fetch is running, which blocks every gap's controls until it answers.
    ///
    /// Set by the host, because only the host knows whether it can serve more than one at a
    /// time. Left false, each gap still blocks its own controls while it waits.
    in property <bool> gap-busy: false;

    callback gap-expand-requested(DiffGapExpandRequest);

    i-list := ListView {
        horizontal-scrollbar-policy: root.show-horizontal-scrollbar
            ? ScrollBarPolicy.as-needed
            : ScrollBarPolicy.always-off;

        for r[i] in root.rows: DiffRowView {
            height: root.row-height;
            data: r;
            advance: i-metrics.advance;
            letter-spacing: i-metrics.letter-spacing;
            gutter-width: root.gutter-width;
            content-width: root.content-width;
            scroll-x: root.scroll-x;
            visible-width: i-list.visible-width;
            show-line-numbers: root.show-line-numbers;
            gutter-columns: root.gutter-columns;

            index: i;
            selectable: root.selectable;
            sel-start: i-math.sel-start;
            sel-end: i-math.sel-end;

            select-start(at) => {
                root.selection-anchor = i-math.on-text(at);
                root.selection-focus = root.selection-anchor;
            }
            select-to(at) => {
                root.selection-focus = i-math.on-text(at);
            }
            select-end => {
                root.selection-finished({
                    anchor: root.selection-anchor,
                    focus: root.selection-focus,
                });
            }

            clicked => {
                // Only rows that name a line are worth reporting, and the row says whether it
                // does. Nothing here works out what kind of row it is.
                if (r.id-line > 0) {
                    root.line-clicked({ document: r.id-document, line: r.id-line });
                }
            }

            expand-step: root.gap-expand-step;
            gap-expandable: root.gap-expandable;
            gap-details: root.gap-details;
            gap-busy: root.gap-busy;

            expand(left, right, count) => {
                root.gap-expand-requested({
                    left-start: left,
                    right-start: right,
                    count: count,
                });
            }
        }
    }
}
