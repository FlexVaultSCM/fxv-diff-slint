import { Spinner } from "std-widgets.slint";
import { DiffStyle } from "style.slint";

// A control on a gap row: an icon saying what it does, and a count saying how much.
//
// Sizes itself from its content rather than being given a width, so a row of these can be laid
// out without anyone counting characters. That matters because the count beside the icon may
// be one digit or four, and because a control that is working replaces its icon with a spinner
// and must not change size while it does.
export component GapButton {
    in property <image> icon;
    // Normally a line count.
    in property <string> label;
    // This control started the fetch that is running. Shows a spinner where its icon goes.
    in property <bool> busy: false;
    // Something is running, whether or not it was this control. Nothing here is clickable
    // while that is true: two fetches at once means two answers racing to be displayed.
    in property <bool> blocked: false;
    callback clicked();

    out property <bool> active: !root.blocked && !root.busy;

    Rectangle {
        background: i-touch.has-hover && root.active ? DiffStyle.gutter-background : transparent;
        border-width: 1px;
        border-color: DiffStyle.separator-color;
        // Dimmed rather than hidden, so the row keeps its shape while a fetch runs.
        opacity: root.active ? 1.0 : 0.45;

        i-touch := TouchArea {
            enabled: root.active;
            clicked => {
                root.clicked();
            }
        }

        HorizontalLayout {
            padding-left: DiffStyle.gutter-padding;
            padding-right: DiffStyle.gutter-padding;
            spacing: DiffStyle.gutter-padding / 2;
            alignment: center;

            // Both occupy the same square, so swapping one for the other moves nothing.
            if !root.busy: Image {
                source: root.icon;
                width: DiffStyle.gap-icon-size;
                height: self.width;
                // Letterboxed, so an icon of any aspect ratio leaves the control the same size.
                image-fit: contain;
                colorize: DiffStyle.gutter-text-color;
            }

            if root.busy: Spinner {
                width: DiffStyle.gap-icon-size;
                height: self.width;
                indeterminate: true;
            }

            Text {
                text: root.label;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-family: DiffStyle.font-family;
                font-size: DiffStyle.font-size;
                color: DiffStyle.gutter-text-color;
            }
        }
    }
}
