// Types crossing the crate boundary. Everything here is re-exported from lib.slint and
// becomes a public Rust type in fxv_diff_slint::ui.

// Which side of the diff a line belongs to. Left is the pre-image, right is the post-image.
export enum DiffSide {
    left,
    right,
    // Context lines exist on both sides.
    both,
}

export enum DiffRowKind {
    // A file header: path, mode change, rename.
    header,
    // The @@ line introducing a hunk.
    hunk-header,
    // Unchanged, shown for context.
    context,
    added,
    removed,
    // Lines that exist but are not shown. Clicking expands them.
    gap,
    // Placeholder opposite an add or remove in side-by-side, so the two panes stay aligned.
    filler,
}

// Why a gap's lines are not on screen. Only meaningful on a gap row.
export enum DiffGapState {
    // Nobody has asked for them, so the gap offers to open.
    hidden,
    // Somebody has, and they have not arrived.
    waiting,
    // Somebody did and it did not work. The row's text carries the reason.
    failed,
}

// Why a range of a line is painted, which is what picks its colour.
//
// WIP: becomes an index into a list of styles carried by the view, so a host can define its
// own kinds and how each is drawn without this enum listing them.
export enum DiffHighlightKind {
    // What the user is selecting now.
    selection,
    // Supplied from outside: a stored selection, or something the host is pointing at.
    marked,
}

// A range of one row to paint behind its text.
//
// Display columns, not source characters. The crate converts, because how many columns a
// character occupies depends on the tab width and on whether whitespace is being shown, and
// nothing outside the widget should have to know that.
export struct DiffHighlight {
    start: int,
    // Ignored when to-end is set.
    end: int,
    // Whether the span takes the line ending with it. Such a span is drawn out to the edge of
    // the pane rather than stopping at the last glyph, because past the final character the
    // newline is what the rest of the row stands for.
    to-end: bool,
    kind: DiffHighlightKind,
}

// One rendered row. The view is driven entirely by a flat list of these, so the inline and
// side-by-side layouts differ only in how the list was built, not in how it is drawn.
export struct DiffRow {
    kind: DiffRowKind,
    // 1-based line numbers. 0 means "no number on this side", which is the case for an
    // added line's left column, a gap, or a filler.
    left-line: int,
    right-line: int,
    // The line content, already tab-expanded, without the leading +/-/space marker. On a gap
    // row this is the hunk heading, or the reason a fetch failed.
    text: string,
    // How many lines this gap hides. Only meaningful when kind is gap.
    hidden-count: int,
    gap-state: DiffGapState,
    // The run of a gap being fetched, numbered on the right. A zero count means nothing is.
    // A view compares this against what each of its controls would ask for, to know which one
    // to show as working. Carried in the data rather than remembered by the row, because the
    // row is rebuilt the moment the fetch is recorded.
    busy-start: int,
    busy-count: int,
    // Ranges to paint behind the text. Empty on most rows.
    highlights: [DiffHighlight],
}

// Identifies a line by side and line number rather than by row index, so it stays valid when
// expanding a gap inserts rows above it.
export struct DiffLineRef {
    side: DiffSide,
    line: int,
}

// A request for some of the lines a gap is hiding. The host fetches them however it likes and
// hands them back; this crate performs no IO.
//
// A gap can be opened a piece at a time, so this names a run rather than the whole gap. Both
// line numbers are given because the same content sits at different numbers on each side, and
// the host may hold either version of the file.
export struct GapExpandRequest {
    // 1-based, inclusive, on each side.
    left-start: int,
    right-start: int,
    count: int,
}

export enum DiffLayoutMode {
    inline,
    side-by-side,
}
