import { Palette } from "std-widgets.slint";

// Embedded rather than looked up from the system so the character advance and line height are
// identical on every platform. The column grid that positions line numbers, highlights and
// text all depends on that, so this must not become a system font lookup.
//
// The import is unconditional and costs 343 KB. It cannot be put behind a cargo feature: doing
// so would mean generating this import statement, and a consuming crate re-parses these
// sources without access to anything generated here. A consumer that would rather use its own
// font can set CodeStyle.font-family, and then pays for a font it does not use.
import "../../fonts/DejaVuSansMono.ttf";

// How both panes look. Nothing here is about diffs: it is fonts, spacing, and the tables that
// say what a row class and a highlight channel are drawn in, all of which a pane showing a
// plain file needs just as much as one showing a change.
//
// Defaults derive from the std-widgets Palette so the widget follows the host application's
// light or dark theme with no configuration. Every property is `in`, so a host can override any
// of them from .slint or from Rust.
export global CodeStyle {
    // == Font
    in property <string> font-family: "DejaVu Sans Mono";
    in property <length> font-size: 13px;

    // == Row backgrounds
    in property <brush> added-background: Palette.color-scheme == ColorScheme.dark
        ? #12280f : #e6ffec;
    in property <brush> removed-background: Palette.color-scheme == ColorScheme.dark
        ? #2a1010 : #ffebe9;
    in property <brush> context-background: transparent;
    in property <brush> gap-background: Palette.color-scheme == ColorScheme.dark
        ? #16202c : #f0f4f8;
    in property <brush> filler-background: Palette.color-scheme == ColorScheme.dark
        ? #1a1a1a : #f6f8fa;

    // One background per row class, indexed by the class number a row carries. Replace the
    // whole list to add classes: a host whose rows are not diff rows styles its own past the
    // six this crate produces.
    //
    // The order is the contract, and it matches `RowClass` in Rust. A test asserts they agree,
    // because nothing else would notice if they drifted.
    in property <[brush]> class-backgrounds: [
        root.context-background,
        root.added-background,
        root.removed-background,
        root.gap-background,
        root.filler-background,
        root.context-background,
    ];

    // == Intra-line highlight, drawn over the row background.
    // Stronger than the row tint on purpose: the row says "this line changed", these say
    // "these characters changed".
    in property <brush> added-word-background: Palette.color-scheme == ColorScheme.dark
        ? #1f5427 : #abf2bc;
    in property <brush> removed-word-background: Palette.color-scheme == ColorScheme.dark
        ? #6b2020 : #ffc9c9;

    // == Ranges painted behind the text
    //
    // Drawn over the row background and under the glyphs, so a selected added line still reads
    // as added. Both are translucent for that reason.
    in property <brush> selection-background: Palette.selection-background.transparentize(0.55);
    in property <brush> marked-background: Palette.color-scheme == ColorScheme.dark
        ? #4a3a0f.transparentize(0.3) : #fff3c4.transparentize(0.2);

    // One brush per channel, indexed by the channel number a highlight carries. Replace the
    // whole list to define more: a host painting review comments or search results adds its
    // own entries past the two this crate produces itself.
    //
    // A channel with no entry here draws nothing, because an out-of-range index yields a
    // default brush. That is deliberate: an unstyled channel showing up in some arbitrary
    // colour would read as meaning something.
    in property <[brush]> channel-backgrounds: [
        root.selection-background,
        root.marked-background,
    ];

    // == Foreground
    in property <brush> text-color: Palette.foreground;
    in property <brush> gutter-text-color: Palette.foreground.transparentize(0.45);
    in property <brush> gutter-background: Palette.alternate-background;
    in property <brush> separator-color: Palette.border;

    // == Gap controls
    //
    // Shipped with the crate and overridable, like every other property here. They are images
    // rather than font glyphs because a glyph resolves through font fallback, and a character
    // whose advance differs from the embedded font's would put the column grid out.
    //
    // Down opens the top of a gap, against the hunk above it, and up opens the bottom. That
    // names the direction the newly shown lines travel, not the end they are taken from.
    //
    // Each control draws its icon beside a line count, so an icon set to a blank image leaves
    // a bare number with nothing to say what it does.
    in property <image> gap-expand-down-icon: @image-url("../icons/expand-down.svg");
    in property <image> gap-expand-up-icon: @image-url("../icons/expand-up.svg");
    in property <image> gap-expand-all-icon: @image-url("../icons/expand-all.svg");
    in property <image> gap-retry-icon: @image-url("../icons/retry.svg");

    // == Geometry
    in property <length> gutter-padding: 8px;
    // Extra space above and below the glyph box, per row.
    in property <length> row-padding: 0px;
    // The square an icon is drawn in, letterboxed to fit. Follows the text size so a control
    // stays inside its row.
    in property <length> gap-icon-size: font-size;
}
