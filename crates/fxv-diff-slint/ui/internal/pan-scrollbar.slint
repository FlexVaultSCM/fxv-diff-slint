import { DiffStyle } from "style.slint";

// Horizontal scrollbar for a panned diff view.
//
// Hand-built because Slint exposes no public ScrollBar, and because a ListView cannot scroll
// horizontally in any case: it computes its own viewport width and discards anything set on it.
//
// Separated out so a side-by-side view can drive both panes from one bar rather than showing
// two that always agree.
export component PanScrollbar {
    // Width of the widest content being panned. With two panes, the wider of the two.
    in property <length> content-width;
    // Width visible at once. With two panes, one pane's worth, since they pan together.
    in property <length> visible-width;
    in-out property <length> pan-offset;

    out property <length> max-pan: max(0px, root.content-width - root.visible-width);

    height: 10px;

    public function pan-to(x: length) {
        root.pan-offset = clamp(x, 0px, root.max-pan);
    }

    Rectangle {
        background: DiffStyle.gutter-background;

        i-drag := TouchArea {
            moved => {
                if (self.pressed) {
                    root.pan-to(root.pan-offset + (self.mouse-x - self.pressed-x));
                }
            }
        }

        Rectangle {
            visible: root.max-pan > 0px;
            // Both divisors are zero whenever the content fits, which would put a NaN into
            // the geometry.
            x: root.max-pan > 0px
                ? (parent.width - self.width) * (root.pan-offset / root.max-pan)
                : 0px;
            width: root.content-width > 0px
                ? max(24px, parent.width * (root.visible-width / root.content-width))
                : parent.width;
            height: parent.height;
            background: DiffStyle.separator-color;
        }
    }
}
