@@ -13,6 +13,17 @@ import { Probes } from "probes.slint";
 //
 // The probes also have to be clipped rather than merely moved out of view. At this length the
 // width probe is a 32000px wide Text, and the renderer panics computing bounds for it.
+//
+// `Text.font-metrics` looks like it makes the height probe redundant, and it nearly does:
+// `ascent - descent` is exact and sub-pixel, and matches this probe to the last decimal for
+// the bundled font. Do not substitute it. Slint's line advance is `ascent - descent + leading`
