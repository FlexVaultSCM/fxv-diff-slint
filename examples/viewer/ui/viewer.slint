import { Button, ComboBox, LineEdit, TabWidget } from "std-widgets.slint";
import { DiffView, DiffScrollbar, DiffRow, DiffSide, DiffStyle, GapExpandRequest } from "@FxvDiff";

export component MainWindow inherits Window {
    // One flat list of every file in every sample, rather than picking a sample and then a
    // file within it. Two pickers to reach one file was a step more than the content warranted.
    in property <[string]> diff-names;
    in-out property <int> current-diff;

    // Plain files, shown by the same pane with no diff involved.
    in property <[string]> plain-names;
    in-out property <int> current-plain;
    in property <[DiffRow]> plain-rows;
    in property <int> plain-columns;

    in property <[DiffRow]> inline-rows;
    in property <int> inline-columns;

    in property <[DiffRow]> left-rows;
    in property <[DiffRow]> right-rows;
    // One value for both panes: differing scrollable widths would let the sides drift apart.
    in property <int> split-columns;

    // Shown instead of the view when the selected file has nothing to render, which is the
    // case for a binary file or a change that only altered the mode.
    in property <string> status;

    in-out property <bool> side-by-side: false;

    // A host that cannot fetch lines leaves this off and its gaps become labels. Toggled here
    // so both behaviours are visible from the same build.
    in-out property <bool> gap-expandable: true;

    // 0 shows nothing, 1 shows spaces and tabs, 2 adds line endings.
    in-out property <int> whitespace-mode: 0;

    // Which tab is showing. Both tabs are painted either way; this picks which one the match
    // count and the stepping controls report on.
    in-out property <int> current-tab: 0;
    out property <int> matches: root.current-tab == 0 ? root.plain-match-count
        : root.diff-match-count;
    out property <int> at: root.current-tab == 0 ? root.plain-match-at : root.diff-match-at;

    in-out property <string> search-query;
    in property <int> diff-match-count;
    in property <int> plain-match-count;
    // Which match is current, 1-based. 0 for none.
    in property <int> diff-match-at;
    in property <int> plain-match-at;
    // A row to bring into sight, set when stepping between matches. The token is bumped every
    // time, so asking for the match already showing scrolls back to it after manual scrolling.
    in-out property <int> reveal-diff-row: -1;
    in-out property <int> reveal-plain-row: -1;
    in-out property <int> reveal-token;

    callback diff-changed(int);
    callback plain-changed(int);
    callback whitespace-changed();
    callback search-changed();
    callback find-next();
    callback find-previous();
    // Rows are built for whichever layout is on screen, so switching needs a rebuild.
    callback layout-changed();
    // Forwarded from whichever view raised it; the host owns fetching the lines.
    callback gap-expand-requested(GapExpandRequest);

    // Ties the two panes together: both views bind to these, so moving either moves both.
    in-out property <length> shared-scroll-y: 0px;
    in-out property <length> shared-scroll-x: 0px;

    title: "fxv-diff-slint viewer";
    preferred-width: 1300px;
    preferred-height: 700px;
    forward-focus: i-keys;

    i-keys := FocusScope {
        key-pressed(event) => {
            if (event.text == "b" && (event.modifiers.control || event.modifiers.meta)) {
                root.side-by-side = !root.side-by-side;
                root.layout-changed();
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        // Whitespace is about how any text is drawn, so it belongs to the window rather than
        // to either tab.
        Rectangle {
            height: 40px;
            background: DiffStyle.gutter-background;

            HorizontalLayout {
                padding: 6px;
                spacing: 8px;

                LineEdit {
                    width: 260px;
                    placeholder-text: "Find in this pane";
                    text <=> root.search-query;
                    edited => {
                        root.search-changed();
                    }
                    accepted => {
                        root.find-next();
                    }
                }

                Button {
                    text: "<";
                    enabled: root.matches > 0;
                    clicked => {
                        root.find-previous();
                        i-keys.focus();
                    }
                }

                Button {
                    text: ">";
                    enabled: root.matches > 0;
                    clicked => {
                        root.find-next();
                        i-keys.focus();
                    }
                }

                Text {
                    text: root.search-query == "" ? ""
                        : root.matches == 0 ? "no matches"
                        : root.at + " of " + root.matches;
                    vertical-alignment: center;
                    font-family: DiffStyle.font-family;
                    color: DiffStyle.gutter-text-color;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Button {
                    text: root.whitespace-mode == 0 ? "Whitespace: off"
                        : root.whitespace-mode == 1 ? "Whitespace: spaces, tabs"
                        : "Whitespace: and endings";
                    clicked => {
                        root.whitespace-mode = Math.mod(root.whitespace-mode + 1, 3);
                        root.whitespace-changed();
                        i-keys.focus();
                    }
                }
            }
        }

        TabWidget {
            current-index <=> root.current-tab;

            Tab {
                title: "Standalone";

                VerticalLayout {
                    Rectangle {
                        height: 40px;

                        HorizontalLayout {
                            padding: 6px;
                            spacing: 8px;

                            ComboBox {
                                width: 360px;
                                model: root.plain-names;
                                current-index <=> root.current-plain;
                                selected => {
                                    root.plain-changed(self.current-index);
                                    i-keys.focus();
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    // The same pane, with no diff behind it: one number column, no gaps.
                    DiffView {
                        rows: root.plain-rows;
                        longest-line-columns: root.plain-columns;
                        gutter-columns: 1;
                        reveal-row: root.reveal-plain-row;
                        reveal-token: root.reveal-token;
                    }
                }
            }

            Tab {
                title: "Diff";

                VerticalLayout {
                    Rectangle {
                        height: 40px;

                        HorizontalLayout {
                            padding: 6px;
                            spacing: 8px;

                            ComboBox {
                                width: 420px;
                                model: root.diff-names;
                                current-index <=> root.current-diff;
                                selected => {
                                    root.diff-changed(self.current-index);
                                    i-keys.focus();
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            Button {
                                text: root.gap-expandable ? "Gaps: expandable" : "Gaps: static";
                                clicked => {
                                    root.gap-expandable = !root.gap-expandable;
                                    i-keys.focus();
                                }
                            }

                            Button {
                                text: root.side-by-side ? "Side by side (Ctrl+B)"
                                    : "Inline (Ctrl+B)";
                                clicked => {
                                    root.side-by-side = !root.side-by-side;
                                    root.layout-changed();
                                    i-keys.focus();
                                }
                            }
                        }
                    }

                    if root.status != "": Rectangle {
                        Text {
                            text: root.status;
                            font-family: DiffStyle.font-family;
                            color: DiffStyle.gutter-text-color;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if root.status == "" && !root.side-by-side: DiffView {
                        rows: root.inline-rows;
                        longest-line-columns: root.inline-columns;
                        gap-expandable: root.gap-expandable;
                        reveal-row: root.reveal-diff-row;
                        reveal-token: root.reveal-token;
                        scroll-y <=> root.shared-scroll-y;
                        scroll-x <=> root.shared-scroll-x;

                        line-clicked(ref) => {
                            debug("line clicked", ref.side, ref.line);
                        }
                        gap-expand-requested(req) => {
                            root.gap-expand-requested(req);
                        }
                    }

                    // The panes and the bar that drives them share one conditional block: an id
                    // declared inside an `if` is not visible from a sibling one.
                    if root.status == "" && root.side-by-side: VerticalLayout {
                        HorizontalLayout {
                            spacing: 1px;

                            i-left := DiffView {
                                rows: root.left-rows;
                                longest-line-columns: root.split-columns;
                                gap-expandable: root.gap-expandable;
                                reveal-row: root.reveal-diff-row;
                                reveal-token: root.reveal-token;
                                gutter-columns: 1;
                                scroll-y <=> root.shared-scroll-y;
                                scroll-x <=> root.shared-scroll-x;
                                // One bar below drives both panes.
                                show-horizontal-scrollbar: false;
                                // Overrides the content-derived preference so the two panes split
                                // the width evenly instead of sizing to their own longest line.
                                preferred-width: 0px;

                                line-clicked(ref) => {
                                    debug("left line clicked", ref.line);
                                }
                                gap-expand-requested(req) => {
                                    root.gap-expand-requested(req);
                                }
                            }

                            i-right := DiffView {
                                rows: root.right-rows;
                                longest-line-columns: root.split-columns;
                                // The left pane carries the gap's controls and message for both.
                                gap-expandable: false;
                                gap-details: false;
                                gutter-columns: 1;
                                scroll-y <=> root.shared-scroll-y;
                                scroll-x <=> root.shared-scroll-x;
                                show-horizontal-scrollbar: false;
                                preferred-width: 0px;

                                line-clicked(ref) => {
                                    debug("right line clicked", ref.line);
                                }
                                gap-expand-requested(req) => {
                                    root.gap-expand-requested(req);
                                }
                            }
                        }

                        DiffScrollbar {
                            // Both panes are given the same longest-line count, so their
                            // scrollable widths match and either one describes the range.
                            scrollable-width: i-left.scrollable-width;
                            visible-width: i-left.visible-width;
                            scroll-x <=> root.shared-scroll-x;
                        }
                    }
                }
            }
        }
    }
}

export { DiffStyle }
