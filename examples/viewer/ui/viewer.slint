import { Button } from "std-widgets.slint";
import { DiffView, DiffPanScrollbar, DiffRow, DiffSide, DiffStyle } from "@FxvDiff";

export component MainWindow inherits Window {
    in property <[DiffRow]> inline-rows;
    in property <int> inline-columns;

    in property <[DiffRow]> left-rows;
    in property <[DiffRow]> right-rows;
    in property <int> left-columns;
    in property <int> right-columns;

    in property <string> file-path;
    in-out property <bool> side-by-side: false;

    // Ties the two panes together: both views bind to these, so moving either moves both.
    in-out property <length> shared-scroll: 0px;
    in-out property <length> shared-pan: 0px;

    title: "fxv-diff-slint viewer";
    preferred-width: 1300px;
    preferred-height: 700px;
    forward-focus: i-keys;

    i-keys := FocusScope {
        key-pressed(event) => {
            if (event.text == "b" && (event.modifiers.control || event.modifiers.meta)) {
                root.side-by-side = !root.side-by-side;
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        Rectangle {
            height: 34px;
            background: DiffStyle.gutter-background;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 8px;

                Text {
                    text: root.file-path;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    font-family: DiffStyle.font-family;
                    color: DiffStyle.text-color;
                }

                Button {
                    text: root.side-by-side ? "Side by side (Ctrl+B)" : "Inline (Ctrl+B)";
                    clicked => {
                        root.side-by-side = !root.side-by-side;
                        i-keys.focus();
                    }
                }
            }
        }

        if !root.side-by-side: DiffView {
            rows: root.inline-rows;
            longest-line-columns: root.inline-columns;
            scroll-y <=> root.shared-scroll;
            pan-offset <=> root.shared-pan;

            line-clicked(ref) => {
                debug("line clicked", ref.side, ref.line);
            }

            gap-expand-requested(req) => {
                debug("gap expand", req.side, req.start-line, req.count);
            }
        }

        // The panes and the bar that drives them share one conditional block: an id declared
        // inside an `if` is not visible from a sibling one.
        if root.side-by-side: VerticalLayout {
            HorizontalLayout {
                spacing: 1px;

                i-left := DiffView {
                    rows: root.left-rows;
                    longest-line-columns: root.left-columns;
                    number-side: DiffSide.left;
                    scroll-y <=> root.shared-scroll;
                    pan-offset <=> root.shared-pan;
                    // One bar below drives both panes.
                    show-scrollbar: false;
                    // Overrides the content-derived preference so the two panes split the
                    // width evenly instead of sizing to their own longest line.
                    preferred-width: 0px;

                    line-clicked(ref) => {
                        debug("left line clicked", ref.line);
                    }

                    gap-expand-requested(req) => {
                        debug("gap expand", req.start-line, req.count);
                    }
                }

                i-right := DiffView {
                    rows: root.right-rows;
                    longest-line-columns: root.right-columns;
                    number-side: DiffSide.right;
                    scroll-y <=> root.shared-scroll;
                    pan-offset <=> root.shared-pan;
                    show-scrollbar: false;
                    preferred-width: 0px;

                    line-clicked(ref) => {
                        debug("right line clicked", ref.line);
                    }

                    gap-expand-requested(req) => {
                        debug("gap expand", req.start-line, req.count);
                    }
                }
            }

            DiffPanScrollbar {
                // The panes move together, so the range is whichever has more to show and a
                // page is one pane's width.
                content-width: max(i-left.content-width, i-right.content-width);
                visible-width: i-left.visible-content-width;
                pan-offset <=> root.shared-pan;
            }
        }
    }
}

export { DiffStyle }
