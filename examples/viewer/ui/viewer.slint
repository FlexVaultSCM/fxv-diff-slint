import { Button, ComboBox } from "std-widgets.slint";
import { DiffView, DiffScrollbar, DiffRow, DiffSide, DiffStyle, GapExpandRequest } from "@FxvDiff";

export component MainWindow inherits Window {
    in property <[string]> sample-names;
    in property <[string]> file-names;
    in-out property <int> current-sample;
    in-out property <int> current-file;

    in property <[DiffRow]> inline-rows;
    in property <int> inline-columns;

    in property <[DiffRow]> left-rows;
    in property <[DiffRow]> right-rows;
    // One value for both panes: differing scrollable widths would let the sides drift apart.
    in property <int> split-columns;

    // Shown instead of the view when the selected file has nothing to render, which is the
    // case for a binary file or a change that only altered the mode.
    in property <string> status;

    in-out property <bool> side-by-side: false;

    // A host that cannot fetch lines leaves this off and its gaps become labels. Toggled here
    // so both behaviours are visible from the same build.
    in-out property <bool> gap-expandable: true;

    // 0 shows nothing, 1 shows spaces and tabs, 2 adds line endings.
    in-out property <int> whitespace-mode: 0;

    callback sample-changed(int);
    callback file-changed(int);
    callback whitespace-changed();
    // Rows are built for whichever layout is on screen, so switching needs a rebuild.
    callback layout-changed();
    // Forwarded from whichever view raised it; the host owns fetching the lines.
    callback gap-expand-requested(GapExpandRequest);

    // Ties the two panes together: both views bind to these, so moving either moves both.
    in-out property <length> shared-scroll-y: 0px;
    in-out property <length> shared-scroll-x: 0px;

    title: "fxv-diff-slint viewer";
    preferred-width: 1300px;
    preferred-height: 700px;
    forward-focus: i-keys;

    i-keys := FocusScope {
        key-pressed(event) => {
            if (event.text == "b" && (event.modifiers.control || event.modifiers.meta)) {
                root.side-by-side = !root.side-by-side;
                root.layout-changed();
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        Rectangle {
            height: 40px;
            background: DiffStyle.gutter-background;

            HorizontalLayout {
                padding: 6px;
                spacing: 8px;

                ComboBox {
                    width: 220px;
                    model: root.sample-names;
                    current-index <=> root.current-sample;
                    selected => {
                        root.sample-changed(self.current-index);
                        i-keys.focus();
                    }
                }

                ComboBox {
                    width: 340px;
                    model: root.file-names;
                    current-index <=> root.current-file;
                    selected => {
                        root.file-changed(self.current-index);
                        i-keys.focus();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Button {
                    text: root.whitespace-mode == 0 ? "Whitespace: off"
                        : root.whitespace-mode == 1 ? "Whitespace: spaces, tabs"
                        : "Whitespace: and endings";
                    clicked => {
                        root.whitespace-mode = Math.mod(root.whitespace-mode + 1, 3);
                        root.whitespace-changed();
                        i-keys.focus();
                    }
                }

                Button {
                    text: root.gap-expandable ? "Gaps: expandable" : "Gaps: static";
                    clicked => {
                        root.gap-expandable = !root.gap-expandable;
                        i-keys.focus();
                    }
                }

                Button {
                    text: root.side-by-side ? "Side by side (Ctrl+B)" : "Inline (Ctrl+B)";
                    clicked => {
                        root.side-by-side = !root.side-by-side;
                        root.layout-changed();
                        i-keys.focus();
                    }
                }
            }
        }

        if root.status != "": Rectangle {
            Text {
                text: root.status;
                font-family: DiffStyle.font-family;
                color: DiffStyle.gutter-text-color;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.status == "" && !root.side-by-side: DiffView {
            rows: root.inline-rows;
            longest-line-columns: root.inline-columns;
            gap-expandable: root.gap-expandable;
            scroll-y <=> root.shared-scroll-y;
            scroll-x <=> root.shared-scroll-x;

            line-clicked(ref) => {
                debug("line clicked", ref.side, ref.line);
            }
            gap-expand-requested(req) => {
                root.gap-expand-requested(req);
            }

        }

        // The panes and the bar that drives them share one conditional block: an id declared
        // inside an `if` is not visible from a sibling one.
        if root.status == "" && root.side-by-side: VerticalLayout {
            HorizontalLayout {
                spacing: 1px;

                i-left := DiffView {
                    rows: root.left-rows;
                    longest-line-columns: root.split-columns;
                    gap-expandable: root.gap-expandable;
                            gutter-columns: 1;
                    scroll-y <=> root.shared-scroll-y;
                    scroll-x <=> root.shared-scroll-x;
                            // One bar below drives both panes.
                    show-horizontal-scrollbar: false;
                    // Overrides the content-derived preference so the two panes split the
                    // width evenly instead of sizing to their own longest line.
                    preferred-width: 0px;

                    line-clicked(ref) => {
                        debug("left line clicked", ref.line);
                    }
                    gap-expand-requested(req) => {
                        root.gap-expand-requested(req);
                    }

                }

                i-right := DiffView {
                    rows: root.right-rows;
                    longest-line-columns: root.split-columns;
                    // The left pane carries the gap's controls and message for both.
                    gap-expandable: false;
                    gap-details: false;
                    gutter-columns: 1;
                    scroll-y <=> root.shared-scroll-y;
                    scroll-x <=> root.shared-scroll-x;
                            show-horizontal-scrollbar: false;
                    preferred-width: 0px;

                    line-clicked(ref) => {
                        debug("right line clicked", ref.line);
                    }
                    gap-expand-requested(req) => {
                        root.gap-expand-requested(req);
                    }

                }
            }

            DiffScrollbar {
                // Both panes are given the same longest-line count, so their scrollable
                // widths match and either one describes the range.
                scrollable-width: i-left.scrollable-width;
                visible-width: i-left.visible-width;
                scroll-x <=> root.shared-scroll-x;
                }
        }
    }
}

export { DiffStyle }
